# ─────────────────────────────────────────────────────────────────────────────
# Salat Tracker – Environment Variables Template
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
#
# For CI, add each secret in:
#   GitHub → Settings → Secrets and variables → Actions → New repository secret
#
# In the workflow YAML, reference them as: ${{ secrets.SECRET_NAME }}
# ─────────────────────────────────────────────────────────────────────────────

# ── App Environment ──────────────────────────────────────────────────────────
# Set to "development" locally, "test" in CI, "production" in builds.
# This is automatically injected by CI — no need to add it as a GitHub Secret.
VITE_APP_ENV=development

# ── App Metadata ─────────────────────────────────────────────────────────────
# Public-facing app name used in the browser title and meta tags.
VITE_APP_NAME=Salat Tracker
VITE_APP_VERSION=1.0.0

# ── Future: Error Monitoring (e.g. Sentry) ───────────────────────────────────
# If you add error monitoring, add the DSN here.
# In CI: add VITE_SENTRY_DSN as a GitHub Actions secret.
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Future: Cloud Sync / API ─────────────────────────────────────────────────
# If you add a backend API (e.g. prayer times API, user sync), add the base URL.
# VITE_API_BASE_URL=https://api.example.com

# ── Future: Analytics ────────────────────────────────────────────────────────
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
